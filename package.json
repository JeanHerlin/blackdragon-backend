{
  "name": "blackdragon-ff-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Core API for Black Dragon FF top-up sales (Messenger bot + backoffice adapters)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "seed:catalog": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
