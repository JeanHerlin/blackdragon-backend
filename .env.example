PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
ENCRYPTION_KEY=replace_with_a_32_byte_hex_string

DATABASE_URL="postgresql://user:password@localhost:5432/blackdragon_ff"

# mock = simulated outcomes, no real network call. Switch to the real value once API keys arrive.
PAYMENT_PROVIDER=mock
DELIVERY_PROVIDER=mock

# open_er_api = free, keyless live USD->Ar rate, synced every 6h. mock = fixed rate, no network call.
FX_PROVIDER=open_er_api

# brevo = real transactional email, mock = logs to console instead of sending
EMAIL_PROVIDER=brevo
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_SENDER_NAME=Black Dragon FF
BREVO_SENDER_EMAIL=replace_with_a_verified_brevo_sender_email

# Messenger bot adapter — from developers.facebook.com, Messenger product settings.
# Leave unset to keep the bot off; the webhook refuses calls cleanly without these.
MESSENGER_VERIFY_TOKEN=replace_with_any_string_you_choose
MESSENGER_PAGE_ACCESS_TOKEN=replace_with_your_page_access_token
MESSENGER_APP_SECRET=replace_with_your_app_secret
