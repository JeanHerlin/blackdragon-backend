datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Game {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  label                 String
  // g2bulk only publishes one image per game, not per catalogue item (verified against
  // their public API) — this is the default shown on every product's card unless a
  // product sets its own imageUrl override below.
  imageUrl              String?
  isActive              Boolean                @default(false)
  categories            Category[]
  products              Product[]
  supplierCatalogEntries SupplierCatalogEntry[]
}

model Category {
  id                         String    @id @default(uuid())
  gameId                     String
  game                       Game      @relation(fields: [gameId], references: [id])
  code                       String
  label                      String
  requiresAccountCredentials Boolean   @default(false)
  products                   Product[]

  @@unique([gameId, code])
}

model Product {
  id                    String                @id @default(uuid())
  gameId                String
  game                  Game                  @relation(fields: [gameId], references: [id])
  categoryId            String
  category              Category              @relation(fields: [categoryId], references: [id])
  label                 String
  // Freeform context shown to the admin — g2bulk-sourced products get it from the
  // supplier's own catalogue entry; manually-added "compte" products (level up,
  // largage, ...) rely on it entirely since there's no supplier record to read from.
  description           String?
  // Falls back to the parent Game's imageUrl when unset — only set here to override it
  // for a specific product (manual "compte" products especially, which have no g2bulk
  // default at all).
  imageUrl              String?
  productType           String                @default("recharge") // recharge | abonnement | levelup | largage — category-dependent
  externalRef           String                @unique
  basePriceUsd          Float // supplier cost as quoted by g2bulk, always USD
  salePrice             Float // what the customer pays, always Ar
  stockQty              Int                   @default(0)
  stockMode             String                @default("unlimited") // unlimited | limited — limited + stockQty=0 means out of stock
  isActive              Boolean               @default(true)
  deliveryMode          String // auto_g2bulk | manual
  // Which real g2bulk catalogue entry this was created from — null means it predates
  // the catalog-picker flow and hasn't been verified against a real supplier reference.
  sourceCatalogEntryId  String?
  sourceCatalogEntry    SupplierCatalogEntry? @relation(fields: [sourceCatalogEntryId], references: [id])
  orders                Order[]
  promoCodeAttachments  PromoCodeProduct[]
  // A bundle has no single sourceCatalogEntry — it's several g2bulk entries delivered
  // as one sale (e.g. 110+250+500 diamonds shown to the customer as "860 Diamants").
  // The admin sets the combined label/price by hand; basePriceUsd is still the real sum
  // of the components' cost, so margin display keeps working unchanged.
  isBundle              Boolean               @default(false)
  bundleItems           ProductBundleItem[]
}

// Each row is one g2bulk catalogue entry that makes up a bundle product — delivery
// walks this list and calls g2bulk once per unit of quantity (see
// orderService.resolveDeliveryComponents), so "same pack twice" is one row with
// quantity=2, not two separate rows for the same entry.
model ProductBundleItem {
  id             String               @id @default(uuid())
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogEntryId String
  catalogEntry   SupplierCatalogEntry @relation(fields: [catalogEntryId], references: [id])
  quantity       Int                  @default(1)
  sortOrder      Int                  @default(0)

  @@unique([productId, catalogEntryId])
}

// A code is one row; each product it applies to gets its own discount via
// PromoCodeProduct — same code can sit on several products at different discounts,
// per the client's requirement ("le même code peut être appliqué à plusieurs produits,
// mais la remise se définit à l'attache, pas sur le code lui-même").
model PromoCode {
  id        String             @id @default(uuid())
  code      String             @unique
  // Human-readable name shown next to the code everywhere in the admin ("FFNOEL10" /
  // "Promo Noël -10%") — purely for the admin's own memory, never shown to the customer.
  title     String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  products  PromoCodeProduct[]
}

model PromoCodeProduct {
  id            String    @id @default(uuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType  String // percent | fixed — fixed is a flat Ar amount
  discountValue Float
  createdAt     DateTime  @default(now())

  @@unique([promoCodeId, productId])
}

// A snapshot of what g2bulk actually offers, fetched from their public catalogue API
// (see architecture notes) — the admin can only create a Product by picking one of
// these, so externalRef always matches a real supplier reference and delivery can
// never fail because of a typo'd or invented id. `region` exists so a second g2bulk
// region can be added later without a schema change — see conversation with the client.
model SupplierCatalogEntry {
  id           String    @id @default(uuid())
  gameId       String
  game         Game      @relation(fields: [gameId], references: [id])
  supplier     String    @default("g2bulk")
  region       String
  supplierRef  String // g2bulk's raw catalogue id
  name         String // g2bulk's raw name — shown to the admin as the product description
  basePriceUsd Float
  productType  String // recharge | abonnement
  // Set false when a sync no longer sees this entry in g2bulk's live catalogue for its
  // region — the admin never has to guess, every Product/bundle component built on it
  // surfaces as unavailable automatically (see g2bulkCatalogSyncService).
  isAvailable  Boolean   @default(true)
  fetchedAt    DateTime  @default(now())
  products     Product[]
  bundleItems  ProductBundleItem[]
  deliveryItems DeliveryItem[]

  @@unique([supplier, region, supplierRef])
}

model Order {
  id                String             @id @default(uuid())
  channel           String             @default("dev")
  customerRef       String
  // Set only for channel="messenger" — lets the admin's actions (flag issue, reject,
  // reject cashpoint proof) message the customer back. Null for any other channel,
  // since there's nowhere to send a message for those.
  messengerPsid     String?
  productId         String
  product           Product            @relation(fields: [productId], references: [id])
  purchaseType      String // uid | compte
  targetUid         String?
  amount            Float
  // Snapshot, not a relation to PromoCodeProduct — an order's history must survive the
  // admin later detaching or deleting that code from the product (see promoCodeService).
  promoCodeUsed     String?
  discountAr        Float              @default(0)
  status            String             @default("pending_payment")
  // Admin-entered reason, set alongside status by reject/flag-issue, cleared on resolve.
  adminNote         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payment           Payment?
  delivery          Delivery?
  accountCredential AccountCredential?
  credentialToken   CredentialToken?
  paymentProofToken PaymentProofToken?
}

model Payment {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  provider    String   @default("papi") // papi | cashpoint
  providerRef String   @unique
  // papi: pending -> success | failed (via webhook, automatic).
  // cashpoint: awaiting_proof -> proof_submitted -> confirmed | rejected (admin reviews
  // by hand — there's no automated callback for a cash deposit, see paymentProofService).
  status      String   @default("pending")
  // papi-only — returned by the create-payment-link call, re-checked against the webhook
  // payload before trusting it (see papiWebhookController): a forged "SUCCESS" callback
  // without the matching token must never mark an order paid.
  notificationToken String?
  // Cashpoint-only proof the customer submits — null for papi payments.
  senderPhone   String?
  reference     String?
  proofImageUrl String?
  createdAt   DateTime @default(now())
}

// Mirrors CredentialToken's pattern (single-use, time-limited link) but for a cashpoint
// deposit's proof-submission page instead of a compte's login form.
model PaymentProofToken {
  id        String    @id @default(uuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Delivery {
  id          String    @id @default(uuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  mode        String // auto_g2bulk | manual
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?
  deliveredAt DateTime?
  // One row per g2bulk call this delivery actually needs — 1 for a normal product, N
  // for a bundle. Lets the admin see exactly which component failed when the rest went
  // through, and lets a retry skip the ones already marked "success" (never re-deliver
  // diamonds the customer already received).
  items       DeliveryItem[]
}

model DeliveryItem {
  id             String    @id @default(uuid())
  deliveryId     String
  delivery       Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  catalogEntryId String
  catalogEntry   SupplierCatalogEntry @relation(fields: [catalogEntryId], references: [id])
  // Snapshot of the entry's name at delivery time — survives the entry being renamed or
  // re-synced later, so this order's history stays legible regardless.
  label          String
  status         String    @default("pending") // pending | success | failed
  lastError      String?
  deliveredAt    DateTime?
}

model AccountCredential {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id])
  // Which login the customer is handing over — the admin needs this visible immediately
  // (without even revealing the password) to know what kind of account they're signing into.
  provider          String    @default("facebook") // facebook | google | twitter
  loginEncrypted    String
  passwordEncrypted String
  providedAt        DateTime  @default(now())
  viewedAt          DateTime?
}

// Single row, admin-editable — margin display converts basePriceUsd to Ar using this.
// Not the customer-facing multi-currency system from the architecture doc (§7, later);
// this one exists purely so the backoffice can show a correct margin next to each price.
model Settings {
  id            String   @id @default(uuid())
  usdToArRate   Float    @default(4500)
  // Whether the admin is available to process manual "achat par compte" deliveries —
  // that channel requires a human to log into the customer's account, so it must be
  // signalled off when no one is available to act on it.
  isAdminActive Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model CredentialToken {
  id        String    @id @default(uuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Messenger webhooks are stateless HTTP calls — this is where the bot adapter keeps
// track of where each user (by Page-Scoped ID) is in the purchase flow between messages.
model ConversationState {
  id        String   @id @default(uuid())
  psid      String   @unique
  step      String   @default("start")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// One admin, potentially several browsers/devices — each Web Push subscription
// (one per browser install) gets its own row so a push fans out to all of them.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
